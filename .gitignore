# test audio and generated state
prototypes/media/*
!prototypes/media/README.md
prototypes/data/*
!prototypes/data/.htaccess

# server-only settings and deploy secrets
prototypes/config.local.php
prototypes/tools/deploy/

# app: settings written by the installer, the one-time setup key, uploaded songs and live pieces
app/config.local.php
app/config.local.php.*.tmp
app/install.key
app/storage/*
!app/storage/.htaccess

# app deploy secrets (setup keys, database passwords for the test server)
tools/deploy/

# local tooling
node_modules/
.env
*.log
.DS_Store
Thumbs.db

# local dev notes with test credentials
*.local.txt

# local saved copies of the published mock-ups (the sources are in design/)
prototypes/*.html

# Windows app builds
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/dist/

# reference songs for the mastering match (copyrighted music)
mastering-ref/

# Android app builds (the release key lives in ~/.android-keys, its password in tools/deploy/)
mobile/dist/

# WordPress plugin builds (tools/build-wp-plugin.py); the app zip it carries is built too
wordpress/dist/
setup/dist/
wordpress/stationwagon/app.zip
wordpress/stationwagon/app.version

# local Claude Code settings (permission rules for this PC)
.claude/settings.local.json

# downloaded fonts and packages for the brand scripts (only their outlines are kept)
tools/brandkit/fonts/
tools/brandkit/.edge-profile/
