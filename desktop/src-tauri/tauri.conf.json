{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stationwagon Studio",
  "mainBinaryName": "stationwagon-studio",
  "version": "0.6.1",
  "identifier": "za.co.controll.stationwagon.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stationwagon Studio",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Controll",
    "shortDescription": "Stationwagon Studio",
    "longDescription": "The Stationwagon live studio for Windows, with a bridge for BUTT and Mixxx.",
    "copyright": "Controll",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NzlCMTU4MzM2NDFGRQpSV1QrUVRhREZadEhEakNFTS9wdm9VYmxIT0gvT0taWUI0VHdiYnl6KzBzbUcvMER1ZGNpaFhndQo=",
      "endpoints": ["https://controll.co.za/wp-json/stationwagon/v1/desktop/latest-release?current_version={{current_version}}"],
      "windows": { "installMode": "passive" }
    }
  }
}
