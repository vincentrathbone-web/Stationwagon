Options -Indexes

# Every address that isn't a real file goes to index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Settings, the one-time setup key and the version file are never served
<FilesMatch "^(config\.local\.php|install\.key|VERSION)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Pages, scripts and styles: always check for a newer copy. Set here because a parent
  # .htaccess on some hosts forces its own cache header on everything below it.
  <FilesMatch "\.(php|html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The listener playlist: Cloudflare may keep it 2 s, browsers always ask again. (The Cloudflare
  # Cache Rule must keep "Browser TTL: respect origin", or Cloudflare turns max-age=0 into its
  # 2 h default and players freeze; tests/web_test.php checks this.)
  <Files "stream.php">
    Header set Cache-Control "public, max-age=0, s-maxage=2"
  </Files>
  # Now playing (embeds and other sites poll it): ready for a 2 s Cloudflare cache like the playlist
  <Files "nowplaying.php">
    Header set Cache-Control "public, max-age=0, s-maxage=2"
  </Files>
  # Schedule, podcast list and verse of the day (apps and websites): a minute old is fresh enough
  <FilesMatch "^(schedule|podcast|verse)\.php$">
    Header set Cache-Control "public, max-age=60"
  </FilesMatch>
  <FilesMatch "^(timeline|notes|listen)\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # The podcast feed (podcast apps check it often): 5 minutes is fresh enough. The podcast API
  # (recordings, mixdowns, drafts) is never kept anywhere.
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ [^ ?]*/podcast/feed[ ?]#">
    Header set Cache-Control "public, max-age=300"
  </If>
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ [^ ?]*/podcast/api/#">
    # PHP sends the same; behind PHP-FPM (Hestia) its copy can sit in the error-headers table, so a plain
    # "set" adds a second one: drop both copies, then set one that holds for any status
    Header unset Cache-Control
    Header always set Cache-Control "private, no-store"
  </If>
  # Downloads of the station's clips (the staff's Download buttons): never kept by anyone but the person who asked
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ [^ ?]*/manage/download[ ?]#">
    Header unset Cache-Control
    Header always set Cache-Control "private, no-store"
  </If>
  # Who is signed in (the website's header asks): personal, never kept anywhere
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ [^ ?]*/api/me[ ?]#">
    # PHP sends the same; behind PHP-FPM (Hestia) its copy can sit in the error-headers table, so a plain
    # "set" adds a second one: drop both copies, then set one that holds for any status
    Header unset Cache-Control
    Header always set Cache-Control "private, no-store"
  </If>
  # Songs and live pieces never change at the same address
  <FilesMatch "\.mp3$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
