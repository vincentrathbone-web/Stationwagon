Options -Indexes

# Every address that isn't a real file goes to index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Settings, the one-time setup key and the version file are never served
<FilesMatch "^(config\.local\.php|install\.key|VERSION)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Pages, scripts and styles: always check for a newer copy. Set here because a parent
  # .htaccess on some hosts forces its own cache header on everything below it.
  <FilesMatch "\.(php|html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The listener playlist: Cloudflare may keep it 2 s, browsers always ask again. (The Cloudflare
  # Cache Rule must keep "Browser TTL: respect origin", or Cloudflare turns max-age=0 into its
  # 2 h default and players freeze; tests/web_test.php checks this.)
  <Files "stream.php">
    Header set Cache-Control "public, max-age=0, s-maxage=2"
  </Files>
  # Now playing (embeds and other sites poll it): ready for a 2 s Cloudflare cache like the playlist
  <Files "nowplaying.php">
    Header set Cache-Control "public, max-age=0, s-maxage=2"
  </Files>
  <FilesMatch "^(timeline|notes|listen)\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Songs and live pieces never change at the same address
  <FilesMatch "\.mp3$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
