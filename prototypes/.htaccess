# The prototypes change often while testing: make browsers check for a new copy of pages,
# scripts and styles every time instead of running a stale one.
# Server-only settings (the control key) are never served, not even as PHP output
<Files "config.local.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Songs and live pieces never change at the same address, so Cloudflare (and browsers) may
  # keep them without asking the server again. HLS listeners then cost the server almost nothing.
  <FilesMatch "\.mp3$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
